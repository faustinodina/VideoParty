{
  "name": "videoparty",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.10",
    "@expo/vector-icons": "^15.0.2",
    "@microsoft/signalr": "^10.0.0",
    "@pchmn/expo-material3-theme": "^1.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/react-native": "~7.11.0",
    "eslint-config-expo": "~57.0.1",
    "expo": "~57.0.12",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.11",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.12",
    "expo-share-intent": "^8.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-cast": "^4.9.1",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "cross-env": "7.0.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:phone": "expo run:android --device SM_A515U1 --no-bundler && node ./scripts/collect-apk.js arm64-v8a",
    "android:phone:prod": "cross-env EXPO_PUBLIC_API_URL=https://videoparty.fly.dev expo run:android --variant release --device SM_A515U1 --no-bundler && node ./scripts/collect-apk.js arm64-v8a release",
    "android:aab": "node ./scripts/build-aab.js",
    "android:emulator": "expo run:android --device Pixel_9_API_35 --no-bundler && node ./scripts/collect-apk.js x86_64",
    "android:emulator:prod": "cross-env EXPO_PUBLIC_API_URL=https://videoparty.fly.dev expo run:android --variant release --device Pixel_9_API_35 --no-bundler && node ./scripts/collect-apk.js x86_64 release",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "private": true
}
