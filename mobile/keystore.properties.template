# Copy this file to mobile/keystore.properties and fill in real values.
# NEVER commit keystore.properties or the .jks file — both are gitignored.
#
# Generate the keystore once with:
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore videoparty-release.jks -alias videoparty \
#     -keyalg RSA -keysize 2048 -validity 10000
# Place the resulting videoparty-release.jks in the mobile/ directory.
#
# storeFile path is relative to the mobile/ directory.
storeFile=videoparty-release.jks
storePassword=CHANGE_ME
keyAlias=videoparty
keyPassword=CHANGE_ME
